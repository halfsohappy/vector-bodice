{
  "id": "ines_skirt",
  "name": "INES skirt",
  "source": "adapted from the \"INES Skirt\" tutorial by The Mystical Attic",
  "files": [
    "__init__.py",
    "skirt_panel.py",
    "waistband.py",
    "pocket.py",
    "tie.py",
    "pocket_bias.py",
    "settings.py"
  ],
  "measurementGroups": [
    {
      "id": "main",
      "label": "Measurements",
      "required": true,
      "fields": [
        { "key": "waist",         "label": "Waist",         "title": "Circumference at the natural waist",                          "default": 28,    "min": 18,  "max": 60, "step": 0.25 },
        { "key": "skirt_length",  "label": "Skirt length",  "title": "Desired finished length, waist seamline to hem",              "default": 27,    "min": 15,  "max": 45, "step": 0.25 },
        { "key": "hem_allowance", "label": "Hem allowance", "title": "Extra fabric folded under for the narrow hem finish",         "default": 0.625, "min": 0.25, "max": 1.5, "step": 0.125 }
      ]
    }
  ],
  "options": [],
  "pieces": [
    { "id": "front_panel",     "label": "Front Panel" },
    { "id": "back_panel",      "label": "Back Panel" },
    { "id": "front_waistband", "label": "Front Waistband" },
    { "id": "back_waistband",  "label": "Back Waistband" },
    { "id": "pocket_side1",    "label": "Pocket – Side 1 (cut 2)" },
    { "id": "pocket_side2",    "label": "Pocket – Side 2 (cut 2)" },
    { "id": "tie",             "label": "Tie (cut 2)" },
    { "id": "pocket_bias",     "label": "Pocket Bias Strip (cut 2)" }
  ],
  "testSizes": [
    { "label": "S",  "values": { "waist": 26, "skirt_length": 25, "hem_allowance": 0.625 } },
    { "label": "M",  "values": { "waist": 28, "skirt_length": 27, "hem_allowance": 0.625 } },
    { "label": "L",  "values": { "waist": 31, "skirt_length": 28, "hem_allowance": 0.625 } },
    { "label": "XL", "values": { "waist": 34, "skirt_length": 29, "hem_allowance": 0.625 } }
  ]
}
